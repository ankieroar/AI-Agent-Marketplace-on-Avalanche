POSTGRES_PASSWORD=replace_me
AES_KEY_HEX=replace_with_64_hex_characters
API_ACCESS_TOKEN=replace_with_random_secret
PORT=3001
# Only free routing is allowed. Never put this key in NEXT_PUBLIC_*.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
