# -------------------------------------------------------------
# Avalanche Private Warranty & Dispute Protocol Environment
# -------------------------------------------------------------

# Private key of deployer (without 0x or with 0x)
PRIVATE_KEY=your_private_key_here

# Fuji C-Chain Endpoints
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113

# Dispute L1 Endpoints
DISPUTE_L1_RPC_URL=https://managed-nodes.avax.network/ext/bc/CnnZk7teddWLgqy2BD74T6TDUD6oJJVR3DtZTAspXSDd2xCvz/rpc
DISPUTE_L1_WS_URL=wss://managed-nodes.avax.network/ext/bc/CnnZk7teddWLgqy2BD74T6TDUD6oJJVR3DtZTAspXSDd2xCvz/ws
DISPUTE_L1_CHAIN_ID=662831
DISPUTE_L1_BLOCKCHAIN_ID=CnnZk7teddWLgqy2BD74T6TDUD6oJJVR3DtZTAspXSDd2xCvz
DISPUTE_L1_BLOCKCHAIN_ID_BYTES32=0x1ac4f03783f66f0733d25e7b8df833da1d739e7b20404cd2cfd867bf1d270539
DISPUTE_L1_SUBNET_ID=2uZ9urRdTwnu1LRQtizioDZQj2pvQGpd7NpZPT3WoDWD3PWDio

# Deployed Contract Addresses (Updated after deploy)
PING_SENDER_ADDRESS=
PONG_RECEIVER_ADDRESS=

# Day-1 backend (generate local values with apps/api/src/setup-env.mjs)
DATABASE_URL=postgresql://warranty:replace_me@127.0.0.1:5432/warranty
POSTGRES_PASSWORD=replace_me
AES_KEY_HEX=replace_with_64_hex_characters
API_ACCESS_TOKEN=replace_with_random_secret
PORT=3001
# Only free routing is allowed. Never put this key in NEXT_PUBLIC_*.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Day 2 local settings. Default chain mode reads confirmed orders from Hardhat.
DAY2_RPC_URL=http://127.0.0.1:8545
DAY2_CONFIRMATIONS=1
DAY2_AI_MODE=openrouter
# Manifest generated by contracts/scripts/day2-prepare-api.js or the staging deployment.
# DAY2_CONTRACTS_FILE=C:\path\to\day2-local.json
# Comma-separated agent ids exposed by GET /api/agents (default: keccak256("document-summary")).
# DAY2_AGENT_IDS=

# Staging seed (apps/api/src/seed-staging.mjs). DATABASE_URL above must point at
# the least-privilege staging app account; append ?sslmode=require if needed.
SEED_ORDER_ID=
SEED_AGENT_ID=
SEED_POLICY_FILE=
SEED_FIXTURE_FILE=
SEED_CHECKOUT_TX_HASH=
# Optional backend base URL; --check calls /health and expects {"database":"ready"}.
SEED_BACKEND_URL=

# -------------------------------------------------------------
# Day 3 backend worker (apps/api/src/day3-worker.mjs)
# -------------------------------------------------------------
# openrouter requires OPENROUTER_API_KEY. mock is for local plumbing only and
# never counts as a real AI decision; see docs/DAY3-NGUOI2.md.
DAY3_AI_MODE=openrouter
# Set to 1 only to deliberately exercise the local proof/submit path with mock
# analysis. Never use this value as demo evidence on staging or in a pitch.
DAY3_MOCK_ELIGIBLE=

# Settlement chain: ServicePurchased events and confirmed orders.
DAY3_SERVICE_RPC_URL=
# Manifest generated by the Day 2 deploy/prepare script.
DAY3_SERVICE_MANIFEST=
DAY3_CONFIRMATIONS=1
# Agent handled by this worker instance (default keccak256("document-summary")).
DAY3_SERVICE_AGENT_ID=

# Dispute chain: CaseOpened (Gateway) or CaseStatusChanged(Opened) after relay.
DAY3_L1_RPC_URL=
DAY3_L1_MANIFEST=
DAY3_L1_CONFIRMATIONS=1
# Explicit event override: CaseOpened or CaseStatusChanged.
DAY3_CASE_EVENT=
# Optional C-Chain Gateway event override. The worker also watches Gateway
# CaseOpened to queue a case before the Teleporter relay reaches L1.
DAY3_GATEWAY_CASE_EVENT=

# Polling/idempotency.
DAY3_START_BLOCK=
DAY3_LOOKBACK_BLOCKS=500
DAY3_POLL_MS=5000
DAY3_MAX_ATTEMPTS=5
DAY3_LEASE_SECONDS=120
DAY3_BATCH_SIZE=20
DAY3_TX_TIMEOUT_MS=120000
DAY3_STATE_TIMEOUT_MS=15000
DAY3_DEBUG=

# Least-privilege proof submitter. Must be DisputeManager.reviewer(), must NOT
# be the admin or deployer key. Keep this key only in project/.env.
DAY3_SUBMITTER_PRIVATE_KEY=

# Demo/replay input. Prefer the buyer-authenticated execute endpoint so the
# encrypted service_requests row is the source of truth.
DAY3_SERVICE_INPUT_TEXT=
DAY3_SERVICE_INPUT_FILE=
# Demo evidence fallback. Buyer-uploaded evidence in PostgreSQL wins.
DAY3_EVIDENCE_TEXT=
DAY3_EVIDENCE_FILE=

# Official ICM relayer peer discovery (public information, optional if auto-discovery works)
L1_VALIDATOR_NODE_ID=NodeID-Fvet9DW7LD65DL8ek1de49xBXUiJJgEt4
L1_VALIDATOR_P2P=
# Free Fuji read RPC used by the local relayer proxy (no API key).
FUJI_RELAYER_RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com
